{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!**/routeTree.gen.ts",
			"!**/*.generated.*",
			"!packages/*/assets"
		]
	},
	"linter": {
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noUnusedImports": "error",
				"noUnusedVariables": "error"
			},
			"style": {
				"useImportType": "error",
				"useNamingConvention": "error"
			},
			"suspicious": {
				"noExplicitAny": "error"
			}
		}
	},
	"overrides": [
		{
			"includes": ["docs/site/**"],
			"linter": {
				"rules": {
					"style": {
						"useNamingConvention": {
							"level": "error",
							"options": {
								"strictCase": false,
								"conventions": [
									{
										"selector": {
											"kind": "objectLiteralProperty"
										},
										"formats": ["camelCase", "PascalCase", "CONSTANT_CASE"]
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["packages/core/test/**", "packages/core/consumer/**"],
			"linter": {
				"rules": {
					"style": {
						"useNamingConvention": {
							"level": "error",
							"options": {
								"conventions": [
									{
										"selector": {
											"kind": "typeProperty"
										},
										"formats": ["camelCase", "snake_case"]
									},
									{
										"selector": {
											"kind": "objectLiteralProperty"
										},
										"formats": ["camelCase", "snake_case"]
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"packages/ui/src/**",
				"packages/react/src/**",
				"packages/vue/src/**",
				"packages/svelte/src/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"@bchconnect/core": {
										"importNames": ["Client", "createClient"],
										"message": "Use ClientLifecycle or the Register-derived types instead; Client<P> is invariant in P and would tie this package to one protocol set."
									}
								}
							}
						}
					}
				}
			}
		},
		{
			"includes": ["packages/test-utils/**"],
			"linter": {
				"rules": {
					"style": {
						"useNamingConvention": {
							"level": "error",
							"options": {
								"conventions": [
									{
										"selector": {
											"kind": "typeProperty"
										},
										"formats": ["camelCase", "snake_case"]
									},
									{
										"selector": {
											"kind": "objectLiteralProperty"
										},
										"formats": ["camelCase", "snake_case"]
									}
								]
							}
						}
					}
				}
			}
		}
	]
}
