{
	"name": "bchconnect-root",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.5.1",
	"engines": {
		"node": "^22.18.0 || >=24.2.0"
	},
	"scripts": {
		"typecheck": "tsc -b --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run",
		"test:types": "vitest run --typecheck.only --passWithNoTests",
		"build": "pnpm -r --if-present run build",
		"palette": "node packages/ui/tools/palette/generate.ts",
		"palette:check": "node packages/ui/tools/palette/check.ts",
		"assets": "node packages/ui/tools/assets/generate.ts",
		"check": "pnpm typecheck && pnpm lint && pnpm test && pnpm palette:check && pnpm build",
		"changeset": "changeset"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "0.18.5",
		"@biomejs/biome": "2.5.14",
		"@changesets/changelog-github": "1.0.1",
		"@changesets/cli": "3.0.3",
		"@microsoft/api-extractor": "7.59.1",
		"@size-limit/preset-small-lib": "14.0.0",
		"@types/node": "26.6.2",
		"@vitest/coverage-v8": "5.0.1",
		"apcach": "0.6.4",
		"colorjs.io": "0.7.1",
		"publint": "0.3.24",
		"size-limit": "14.0.0",
		"tsdown": "0.23.0",
		"typescript": "7.0.2",
		"vitest": "5.0.1"
	}
}
