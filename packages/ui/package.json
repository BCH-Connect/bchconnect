	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/BCH-Connect/bchconnect.git",
		"directory": "packages/ui"
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
