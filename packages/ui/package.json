{
	"name": "@bchconnect/ui",
	"version": "0.0.0",
	"description": "Connect modal and success toast for BCH Connect",
	"keywords": [
		"bitcoin-cash",
		"bch",
		"walletconnect",
		"wizardconnect",
		"connect",
		"modal",
		"web-components",
		"lit"
	],
	"homepage": "https://bchconnect.dev",
	"bugs": {
		"url": "https://github.com/BCH-Connect/bchconnect/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/BCH-Connect/bchconnect.git",
		"directory": "packages/ui"
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./modal": {
			"types": "./dist/bchconnect-modal.d.ts",
			"default": "./dist/bchconnect-modal.js"
		},
		"./headless": {
			"types": "./dist/headless.d.ts",
			"default": "./dist/headless.js"
		},
		"./locales/es": {
			"types": "./dist/locales/es.d.ts",
			"default": "./dist/locales/es.js"
		},
		"./package.json": "./package.json"
	},
	"types": "./dist/index.d.ts",
	"customElements": "custom-elements.json",
	"files": [
		"dist",
		"custom-elements.json"
	],
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "pnpm cem && tsdown",
		"cem": "cem analyze --config custom-elements-manifest.config.mjs",
		"api": "api-extractor run --local --verbose",
		"storybook": "pnpm cem && storybook dev -p 6006",
		"build-storybook": "pnpm cem && storybook build"
	},
	"dependencies": {
		"lit": "^3.3.3",
		"qr-code-styling": "1.9.2"
	},
	"peerDependencies": {
		"@bchconnect/core": "workspace:^"
	},
	"peerDependenciesMeta": {
		"@bchconnect/core": {
			"optional": true
		}
	},
	"devDependencies": {
		"@bchconnect/core": "workspace:*",
		"@custom-elements-manifest/analyzer": "0.11.0",
		"@fontsource-variable/plus-jakarta-sans": "5.3.0",
		"@storybook/addon-a11y": "10.6.1",
		"@storybook/addon-docs": "10.6.1",
		"@storybook/web-components": "10.6.1",
		"@storybook/web-components-vite": "10.6.1",
		"lightningcss": "1.33.0",
		"storybook": "10.6.1",
		"vite": "8.3.1"
	}
}
