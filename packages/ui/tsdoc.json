{
	"$schema": "https://developer.microsoft.com/json-schemas/tsdoc/v0/tsdoc.schema.json",
	"extends": ["@microsoft/api-extractor/extends/tsdoc-base.json"],
	"tagDefinitions": [
		{ "tagName": "@tag", "syntaxKind": "block" },
		{ "tagName": "@attr", "syntaxKind": "block", "allowMultiple": true },
		{ "tagName": "@fires", "syntaxKind": "block", "allowMultiple": true },
		{ "tagName": "@cssprop", "syntaxKind": "block", "allowMultiple": true }
	],
	"supportForTags": {
		"@tag": true,
		"@attr": true,
		"@fires": true,
		"@cssprop": true
	}
}
