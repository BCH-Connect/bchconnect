{
	"name": "@bchconnect/core",
	"version": "0.0.0",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/BCH-Connect/bchconnect.git",
		"directory": "packages/core"
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.cjs",
	"types": "./dist/index.d.cts",
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "tsdown",
		"api": "api-extractor run --local --verbose"
	},
	"devDependencies": {
		"@bch-wc2/interfaces": "0.0.16",
		"@bitauth/libauth": "3.1.0-next.8",
		"@cashconnect-js/core": "1.0.0-alpha.31",
		"@wizardconnect/core": "0.2.4",
		"libauth-300": "npm:@bitauth/libauth@3.0.0",
		"wc2-interfaces-008": "npm:@bch-wc2/interfaces@0.0.8"
	}
}
