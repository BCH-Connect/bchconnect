{
	"name": "@bchconnect/test-utils",
	"version": "0.1.0",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/BCH-Connect/bchconnect.git",
		"directory": "packages/test-utils"
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.cjs",
	"types": "./dist/index.d.cts",
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "tsdown",
		"api": "api-extractor run --local --verbose"
	},
	"peerDependencies": {
		"@bchconnect/core": "workspace:^"
	},
	"devDependencies": {
		"@bchconnect/core": "workspace:*"
	}
}
